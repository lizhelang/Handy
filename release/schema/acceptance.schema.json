{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "catalog_sha256",
    "subject",
    "created_at",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "plan_id": {
      "const": "P20260930-191324"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "release_id",
        "source_commit",
        "manifest_sha256",
        "artifacts",
        "target"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "artifact", "sha256", "size"],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "architecture", "min_os", "tested_os"],
          "properties": {
            "platform": {
              "const": "macos"
            },
            "architecture": {
              "const": "arm64"
            },
            "min_os": {
              "type": "string"
            },
            "tested_os": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence_level",
          "reason",
          "procedure",
          "executed_at",
          "machine",
          "evidence",
          "metrics",
          "started_at",
          "execution_record"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]
          },
          "evidence_level": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "procedure": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "executed_at": {
            "type": ["string", "null"]
          },
          "machine": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["os", "architecture", "model", "os_version"],
                "properties": {
                  "os": {
                    "type": "string",
                    "minLength": 1
                  },
                  "architecture": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "os_version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "started_at": {
            "type": ["string", "null"]
          },
          "execution_record": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inputia release acceptance ledger",
  "description": "结构层；必需案例集合、等级、阈值、路径/摘要与提交绑定由 scripts/inputia_acceptance.py 执行。"
}
