{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "clipboard-overlay",
  "description": "Minimal core permissions for the clipboard history overlay",
  "windows": ["clipboard_overlay"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
